.container { min-height: 100vh; background: linear-gradient(180deg, #0f172a, #1e293b); padding: 24rpx; }

/* ── 语音模式 ── */
.voice-mode { text-align: center; padding-top: 80rpx; }
.voice-title { font-size: 44rpx; color: #fbbf24; display: block; margin-bottom: 12rpx; }
.voice-desc { font-size: 26rpx; color: #94a3b8; display: block; margin-bottom: 60rpx; }
.record-area { margin-bottom: 60rpx; }
.record-btn { width: 200rpx; height: 200rpx; margin: 0 auto 24rpx; border-radius: 50%; background: rgba(255,255,255,0.05); border: 4rpx solid rgba(255,255,255,0.1); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.record-btn.recording { border-color: #f87171; background: rgba(248,113,113,0.1); animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
.record-icon { font-size: 56rpx; }
.record-text { font-size: 24rpx; color: #94a3b8; margin-top: 8rpx; }
.record-hint { font-size: 24rpx; color: #64748b; display: block; }

/* ── 训练模式 ── */
.chat-header { text-align: center; padding: 16rpx 0 20rpx; }
.chat-scene { font-size: 30rpx; color: #38bdf8; display: block; }
.chat-persona { font-size: 24rpx; color: #94a3b8; display: block; margin-top: 6rpx; }
.share-bar { text-align: center; margin-bottom: 16rpx; }
.share-btn { background: transparent !important; border: 1rpx solid rgba(251,191,36,0.3) !important; color: #fbbf24 !important; font-size: 24rpx !important; }
.share-code { color: #fbbf24; font-size: 28rpx; margin-left: 12rpx; }

.coach-tips { margin-bottom: 12rpx; }
.coach-tip-item { background: rgba(251,191,36,0.1); border: 1rpx solid rgba(251,191,36,0.2); border-radius: 10rpx; padding: 8rpx 16rpx; margin-bottom: 4rpx; color: #fbbf24; font-size: 24rpx; }

.chat-area { height: 60vh; padding: 8rpx 0; }
.msg-item { margin-bottom: 16rpx; }
.msg-label { font-size: 20rpx; color: #64748b; margin-bottom: 4rpx; display: block; }
.msg-bubble { padding: 16rpx 20rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.6; color: #e2e8f0; display: inline-block; max-width: 85%; }
.msg-bubble-bot { background: rgba(129,140,248,0.08); border: 1rpx solid rgba(129,140,248,0.15); }
.msg-bubble-user { background: rgba(56,189,248,0.08); }
.msg-user { text-align: right; }
.msg-typing { text-align: center; color: #64748b; font-size: 24rpx; padding: 16rpx; }
.end-hint { text-align: center; background: rgba(251,191,36,0.1); border-radius: 12rpx; padding: 16rpx; color: #fbbf24; font-size: 24rpx; margin: 16rpx 0; }

.input-bar { display: flex; gap: 12rpx; align-items: center; padding: 16rpx 0; background: rgba(15,23,42,0.9); position: fixed; bottom: 0; left: 0; right: 0; padding-bottom: 40rpx; }
.chat-input { flex: 1; padding: 16rpx 20rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.1); border-radius: 24rpx; color: #e2e8f0; font-size: 28rpx; }
.send-btn { background: linear-gradient(135deg, #38bdf8, #818cf8) !important; color: #fff !important; font-size: 26rpx !important; }
.end-btn { background: transparent !important; border: 1rpx solid rgba(56,189,248,0.3) !important; color: #38bdf8 !important; font-size: 24rpx !important; }

.btn { width: 100%; padding: 28rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; }
.btn-primary { background: linear-gradient(135deg, #38bdf8, #818cf8); color: #fff; }

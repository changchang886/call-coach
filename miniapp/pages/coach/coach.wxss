/* 教练页 */
.container { min-height: 100vh; background: linear-gradient(180deg, #0f172a, #1e293b); padding: 32rpx; }
.join-area { text-align: center; padding-top: 120rpx; }
.join-title { font-size: 40rpx; color: #fbbf24; display: block; margin-bottom: 12rpx; }
.join-desc { font-size: 26rpx; color: #94a3b8; display: block; margin-bottom: 32rpx; }
.code-input-area { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.code-input { flex: 1; padding: 20rpx; text-align: center; background: rgba(255,255,255,0.05); border: 2rpx solid rgba(251,191,36,0.3); border-radius: 16rpx; color: #fbbf24; font-size: 36rpx; letter-spacing: 8rpx; text-transform: uppercase; }
.join-btn { padding: 20rpx 32rpx; background: linear-gradient(135deg, #38bdf8, #818cf8); color: #fff; border-radius: 16rpx; font-size: 28rpx; }
.join-hint { font-size: 24rpx; color: #64748b; display: block; margin-top: 24rpx; }

.watch-header { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; margin-bottom: 16rpx; }
.watch-title { font-size: 28rpx; color: #fbbf24; }
.leave-btn { background: transparent !important; border: 1rpx solid rgba(255,255,255,0.2) !important; color: #94a3b8 !important; font-size: 22rpx !important; }

.ended-hint { text-align: center; padding: 40rpx; color: #64748b; font-size: 28rpx; }

.watch-msgs { height: 65vh; padding: 8rpx 0; }
.watch-msg { margin-bottom: 12rpx; }
.watch-role { font-size: 20rpx; color: #64748b; display: block; margin-bottom: 4rpx; }
.watch-bubble { padding: 12rpx 18rpx; background: rgba(255,255,255,0.04); border-radius: 12rpx; font-size: 26rpx; color: #e2e8f0; line-height: 1.6; }

.tip-bar { display: flex; gap: 12rpx; padding: 16rpx 0; }
.tip-input { flex: 1; padding: 16rpx 20rpx; background: rgba(255,255,255,0.05); border: 2rpx solid rgba(251,191,36,0.2); border-radius: 24rpx; color: #fbbf24; font-size: 26rpx; }
.tip-btn { width: 80rpx; background: #f59e0b; color: #fff; border-radius: 24rpx; font-size: 32rpx; display: flex; align-items: center; justify-content: center; }

<!-- 教练页 -->
<view class="container">

  <!-- 输入分享码 -->
  <view wx:if="{{mode === 'input'}}" class="join-area">
    <text class="join-title">👀 观看他人训练</text>
    <text class="join-desc">输入求助者给你的 6 位分享码</text>
    <view class="code-input-area">
      <input class="code-input" value="{{codeInput}}" placeholder="输入分享码" maxlength="6" bindinput="onCodeInput" />
      <button class="join-btn" bindtap="joinWatch">进入观看</button>
    </view>
    <text class="join-hint">教练可以实时观看对话并发送提示</text>
  </view>

  <!-- 观看模式 -->
  <view wx:if="{{mode === 'watching'}}" class="watch-area">
    <view class="watch-header">
      <text class="watch-title">👀 {{persona}} · 实时对话</text>
      <button class="leave-btn" size="mini" bindtap="backToInput">退出</button>
    </view>

    <view wx:if="{{!active}}" class="ended-hint">会话已结束</view>

    <!-- 对话 -->
    <scroll-view class="watch-msgs" scroll-y>
      <view wx:for="{{messages}}" wx:key="index" class="watch-msg">
        <text class="watch-role">{{item.role}}</text>
        <view class="watch-bubble">{{item.content}}</view>
      </view>
    </scroll-view>

    <!-- 发提示 -->
    <view wx:if="{{active}}" class="tip-bar">
      <input class="tip-input" value="{{tipText}}" placeholder="发送提示给求助者..." bindinput="onTipInput" bindconfirm="sendTip" />
      <button class="tip-btn" bindtap="sendTip">💡</button>
    </view>
  </view>

</view>

/* 广场页 */
.container { min-height: 100vh; background: linear-gradient(180deg, #0f172a, #1e293b); padding: 24rpx; }
.tab-bar { display: flex; gap: 8rpx; margin-bottom: 24rpx; background: rgba(255,255,255,0.04); border-radius: 16rpx; padding: 6rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx; border-radius: 12rpx; font-size: 28rpx; color: #94a3b8; }
.tab.active { background: rgba(56,189,248,0.2); color: #38bdf8; font-weight: 600; }

.feed-list { height: calc(100vh - 200rpx); }
.empty { text-align: center; padding: 100rpx 0; color: #475569; font-size: 28rpx; }

.feed-card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.feed-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.feed-scene { background: rgba(56,189,248,0.15); color: #38bdf8; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }
.feed-time { font-size: 22rpx; color: #64748b; }
.feed-preview { font-size: 28rpx; color: #e2e8f0; line-height: 1.6; display: block; margin-bottom: 12rpx; }
.feed-actions { display: flex; gap: 24rpx; }
.feed-action { font-size: 24rpx; color: #94a3b8; }

.story-card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.story-text { font-size: 30rpx; color: #e2e8f0; line-height: 1.7; display: block; margin-bottom: 12rpx; }
.story-footer { display: flex; justify-content: space-between; }
.story-author { font-size: 22rpx; color: #38bdf8; }

.loading { text-align: center; padding: 100rpx 0; color: #64748b; font-size: 28rpx; }

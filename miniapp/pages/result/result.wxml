<!-- 结果页 -->
<view class="container">

  <!-- 评分（仅训练模式） -->
  <view wx:if="{{score !== null}}" class="score-card">
    <text class="score-num">{{score}}</text>
    <text class="score-max">/10</text>
    <text class="score-summary">{{summary}}</text>
  </view>

  <view wx:if="{{goodPoints.length}}" class="feedback-card">
    <text class="card-title good">👍 做得好的</text>
    <view wx:for="{{goodPoints}}" wx:key="*this" class="feedback-item">{{item}}</view>
  </view>
  <view wx:if="{{improvePoints.length}}" class="feedback-card">
    <text class="card-title improve">🔧 可以改进</text>
    <view wx:for="{{improvePoints}}" wx:key="*this" class="feedback-item">{{item}}</view>
  </view>

  <!-- 剧本 -->
  <view wx:if="{{script}}" class="script-area">
    <view wx:if="{{script.opening}}" class="script-card">
      <text class="script-label">🎤 开场白</text>
      <view class="script-hero">{{script.opening}}</view>
    </view>

    <view wx:if="{{script.main_script}}" class="script-card">
      <text class="script-label">📜 主体话术</text>
      <view wx:for="{{script.main_script}}" wx:key="*this" class="script-line">{{item}}</view>
    </view>

    <view wx:if="{{script.branches}}" class="script-card">
      <text class="script-label">🔀 如果对方说...</text>
      <view wx:for="{{script.branches}}" wx:key="if" class="branch-item">
        <text class="branch-if">👉 {{item.if}}</text>
        <text class="branch-reply">💬 {{item.reply}}</text>
      </view>
    </view>

    <view wx:if="{{script.closing}}" class="script-card">
      <text class="script-label">👋 结尾</text>
      <view class="script-line">{{script.closing}}</view>
    </view>

    <view wx:if="{{script.tips}}" class="script-card">
      <text class="script-label">💡 温馨提示</text>
      <view wx:for="{{script.tips}}" wx:key="*this" class="script-line">{{index+1}}. {{item}}</view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="btn btn-primary" bindtap="goHome">🔄 再练一次</button>
  </view>

</view>

.container { min-height: 100vh; background: linear-gradient(180deg, #0f172a, #1e293b); padding: 32rpx 24rpx 80rpx; }

/* 评分 */
.score-card { text-align: center; padding: 40rpx 0 20rpx; }
.score-num { font-size: 100rpx; font-weight: bold; color: #4ade80; }
.score-max { font-size: 32rpx; color: #94a3b8; }
.score-summary { color: #e2e8f0; font-size: 28rpx; margin-top: 12rpx; }

/* 反馈 */
.feedback-card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.card-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 12rpx; }
.card-title.good { color: #4ade80; }
.card-title.improve { color: #f87171; }
.feedback-item { color: #94a3b8; font-size: 26rpx; line-height: 1.8; padding-left: 8rpx; }

/* 剧本 */
.script-area { margin-top: 16rpx; }
.script-card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.script-label { font-size: 26rpx; color: #38bdf8; font-weight: bold; display: block; margin-bottom: 12rpx; }
.script-hero { background: rgba(56,189,248,0.1); border-left: 4rpx solid #38bdf8; border-radius: 0 12rpx 12rpx 0; padding: 16rpx 20rpx; font-size: 30rpx; color: #e2e8f0; line-height: 1.7; }
.script-line { padding: 12rpx 0; color: #e2e8f0; font-size: 28rpx; line-height: 1.7; border-bottom: 1rpx solid rgba(255,255,255,0.04); }
.script-line:last-child { border-bottom: none; }

.branch-item { padding: 14rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.04); }
.branch-item:last-child { border-bottom: none; }
.branch-if { color: #f87171; font-size: 24rpx; display: block; margin-bottom: 6rpx; }
.branch-reply { color: #e2e8f0; font-size: 28rpx; line-height: 1.6; display: block; }

/* 底部 */
.bottom-actions { margin-top: 30rpx; }
.btn { width: 100%; padding: 28rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; text-align: center; }
.btn-primary { background: linear-gradient(135deg, #38bdf8, #818cf8); color: #fff; border: none; }

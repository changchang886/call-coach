.container { min-height: 100vh; background: linear-gradient(180deg, #0f172a, #1e293b); padding: 32rpx; padding-bottom: 120rpx; }
.score-card { text-align: center; padding: 40rpx 0; }
.score-num { font-size: 120rpx; font-weight: bold; color: #4ade80; }
.score-max { font-size: 40rpx; color: #94a3b8; }
.score-summary { font-size: 28rpx; color: #e2e8f0; display: block; margin-top: 16rpx; }

.feedback-card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.card-title { font-size: 26rpx; display: block; margin-bottom: 12rpx; }
.card-title.good { color: #4ade80; }
.card-title.improve { color: #f87171; }
.feedback-item { color: #94a3b8; font-size: 26rpx; line-height: 1.7; padding-left: 20rpx; margin-bottom: 6rpx; }

.phone-card { background: rgba(251,191,36,0.05); border: 1rpx dashed rgba(251,191,36,0.3); border-radius: 16rpx; padding: 32rpx; text-align: center; margin-bottom: 24rpx; }
.phone-title { font-size: 30rpx; color: #fbbf24; display: block; margin-bottom: 8rpx; }
.phone-desc { font-size: 24rpx; color: #94a3b8; display: block; margin-bottom: 20rpx; }
.phone-btn { width: 80% !important; margin: 0 auto 16rpx; background: linear-gradient(135deg, #38bdf8, #818cf8) !important; color: #fff !important; border-radius: 24rpx !important; font-size: 28rpx !important; }
.phone-skip { font-size: 24rpx; color: #64748b; }

.unlock-banner { text-align: center; font-size: 30rpx; color: #38bdf8; padding: 20rpx 0; margin-bottom: 16rpx; }

.script-card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.script-label { font-size: 24rpx; color: #38bdf8; display: block; margin-bottom: 12rpx; }
.script-hero { padding: 16rpx 20rpx; background: rgba(56,189,248,0.1); border-left: 4rpx solid #38bdf8; border-radius: 8rpx; font-size: 28rpx; color: #e2e8f0; line-height: 1.7; }
.script-line { padding: 12rpx 16rpx; background: rgba(255,255,255,0.03); border-radius: 8rpx; margin-bottom: 8rpx; font-size: 26rpx; color: #e2e8f0; line-height: 1.6; }
.branch-item { padding: 14rpx 16rpx; background: rgba(129,140,248,0.06); border: 1rpx solid rgba(129,140,248,0.15); border-radius: 10rpx; margin-bottom: 10rpx; }
.branch-if { font-size: 26rpx; color: #f87171; display: block; margin-bottom: 6rpx; }
.branch-reply { font-size: 26rpx; color: #e2e8f0; line-height: 1.6; }

.share-btn-bottom { width: 100% !important; background: linear-gradient(135deg, #38bdf8, #818cf8) !important; color: #fff !important; border-radius: 16rpx !important; font-size: 28rpx !important; margin-bottom: 16rpx; }
.retry-btn { width: 100% !important; background: transparent !important; border: 2rpx solid rgba(56,189,248,0.3) !important; color: #38bdf8 !important; border-radius: 16rpx !important; font-size: 28rpx !important; }

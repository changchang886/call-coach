.container { padding: 32rpx 24rpx; min-height: 100vh; background: linear-gradient(180deg, #0f172a, #1e293b); }
.header { text-align: center; padding: 60rpx 0 40rpx; }
.title { font-size: 48rpx; color: #e2e8f0; display: block; margin-bottom: 12rpx; font-weight: bold; }
.subtitle { font-size: 26rpx; color: #94a3b8; }

.scene-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 40rpx; }
.scene-card { background: rgba(255,255,255,0.05); border: 2rpx solid rgba(255,255,255,0.08); border-radius: 20rpx; padding: 32rpx 24rpx; text-align: center; transition: all 0.2s; }
.scene-card:active { transform: scale(0.97); }
.scene-card.active { background: rgba(56,189,248,0.12); border-color: #38bdf8; }
.scene-emoji { font-size: 40rpx; display: block; margin-bottom: 8rpx; }
.scene-name { font-size: 30rpx; color: #e2e8f0; display: block; margin-bottom: 6rpx; }
.scene-goal { font-size: 22rpx; color: #64748b; display: block; }

.actions { margin-top: 20rpx; }
.action-hint { text-align: center; color: #38bdf8; font-size: 28rpx; margin-bottom: 24rpx; }
.btn { width: 100%; padding: 28rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; text-align: center; }
.btn-primary { background: linear-gradient(135deg, #38bdf8, #818cf8); color: #fff; }
.btn-secondary { background: transparent; border: 2rpx solid rgba(56,189,248,0.3); color: #38bdf8; }
.btn-voice { background: transparent; border: 2rpx solid rgba(251,191,36,0.3); color: #fbbf24; }

.empty-hint { text-align: center; padding: 80rpx 0; color: #475569; font-size: 28rpx; }

.container { min-height: 100vh; background: linear-gradient(180deg, #0f172a, #1e293b); }

/* 场景选择 */
.scene-view { padding: 32rpx 24rpx; }
.header { text-align: center; padding: 60rpx 0 40rpx; }
.title { font-size: 48rpx; color: #e2e8f0; display: block; margin-bottom: 12rpx; font-weight: bold; }
.subtitle { font-size: 26rpx; color: #94a3b8; }

.scene-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.scene-card { background: rgba(255,255,255,0.05); border: 2rpx solid rgba(255,255,255,0.08); border-radius: 20rpx; padding: 32rpx 24rpx; text-align: center; }
.scene-card:active { transform: scale(0.97); background: rgba(56,189,248,0.12); border-color: #38bdf8; }
.scene-emoji { font-size: 40rpx; display: block; margin-bottom: 8rpx; }
.scene-name { font-size: 30rpx; color: #e2e8f0; display: block; margin-bottom: 6rpx; }
.scene-goal { font-size: 22rpx; color: #64748b; display: block; }

/* 聊天 */
.chat-page { height: 100vh; position: relative; overflow: hidden; }
.chat-scroll-wrap { display: flex; flex-direction: column; height: 100%; padding-bottom: 260rpx; box-sizing: border-box; }
.chat-header { text-align: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid rgba(255,255,255,0.06); flex-shrink: 0; }
.chat-scene { font-size: 30rpx; color: #38bdf8; display: block; }
.chat-persona { font-size: 24rpx; color: #94a3b8; display: block; margin-top: 4rpx; }

.chat-area { flex: 1; padding: 16rpx 32rpx; min-height: 0; box-sizing: border-box; }
.msg-item { margin-bottom: 20rpx; }
.msg-label { font-size: 20rpx; color: #64748b; margin-bottom: 4rpx; display: block; }
.msg-bubble { padding: 16rpx 20rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.6; color: #e2e8f0; display: inline-block; max-width: 84%; word-break: break-word; overflow-wrap: break-word; box-sizing: border-box; }
.msg-bubble-bot { background: rgba(129,140,248,0.1); border: 1rpx solid rgba(129,140,248,0.15); }
.msg-bubble-user { background: rgba(56,189,248,0.1); }
.msg-user { text-align: right; }

/* 输入区 */
.input-area { position: absolute; bottom: 0; left: 0; right: 0; z-index: 10; padding: 12rpx 24rpx 40rpx; border-top: 1rpx solid rgba(255,255,255,0.06); background: rgba(15,23,42,0.95); }
.input-row { display: flex; gap: 12rpx; align-items: center; margin-bottom: 12rpx; }
.chat-input { flex: 1; padding: 16rpx 20rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.1); border-radius: 24rpx; color: #e2e8f0; font-size: 28rpx; }
/* 麦克风按钮（hold-to-record） */
.mic-hold-btn { flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,255,255,0.08); border: 2rpx solid rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center; font-size: 32rpx; line-height: 1; }
.mic-hold-active { background: rgba(239,68,68,0.3); border-color: #ef4444; }
/* 录音浮层 */
.record-overlay { text-align: center; padding: 20rpx 0 12rpx; }
.record-wave-big { display: flex; align-items: center; justify-content: center; gap: 6rpx; height: 48rpx; margin-bottom: 8rpx; }
.wave-bar-big { width: 8rpx; border-radius: 4rpx; background: #ef4444; animation: waveBar 0.8s ease-in-out infinite; }
.wave-bar-big:nth-child(1)  { height: 14rpx; animation-delay: 0s; }
.wave-bar-big:nth-child(2)  { height: 24rpx; animation-delay: 0.06s; }
.wave-bar-big:nth-child(3)  { height: 34rpx; animation-delay: 0.12s; }
.wave-bar-big:nth-child(4)  { height: 44rpx; animation-delay: 0.18s; }
.wave-bar-big:nth-child(5)  { height: 34rpx; animation-delay: 0.24s; }
.wave-bar-big:nth-child(6)  { height: 24rpx; animation-delay: 0.3s; }
.wave-bar-big:nth-child(7)  { height: 14rpx; animation-delay: 0.36s; }
.wave-bar-big:nth-child(8)  { height: 24rpx; animation-delay: 0.42s; }
.wave-bar-big:nth-child(9)  { height: 34rpx; animation-delay: 0.48s; }
.wave-bar-big:nth-child(10) { height: 44rpx; animation-delay: 0.54s; }
.wave-bar-big:nth-child(11) { height: 34rpx; animation-delay: 0.6s; }
.wave-bar-big:nth-child(12) { height: 24rpx; animation-delay: 0.66s; }
.wave-bar-big:nth-child(13) { height: 14rpx; animation-delay: 0.72s; }
.wave-bar-big:nth-child(14) { height: 10rpx; animation-delay: 0.78s; }
@keyframes waveBar { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }
.record-hint { font-size: 22rpx; color: #ef4444; margin-bottom: 12rpx; }
.record-stop-btn { display: inline-block; padding: 16rpx 60rpx; background: rgba(239,68,68,0.25); border: 1rpx solid #ef4444; border-radius: 40rpx; color: #fff; font-size: 26rpx; }

.send-btn { flex-shrink: 0; padding: 16rpx 28rpx; background: linear-gradient(135deg, #38bdf8, #818cf8); color: #fff; font-size: 28rpx; border-radius: 24rpx; text-align: center; line-height: 1.4; }
.send-disabled { opacity: 0.3; pointer-events: none; }

.chat-actions { display: flex; gap: 10rpx; flex-wrap: wrap; }
.action-btn { flex: 1; min-width: 180rpx; padding: 14rpx 10rpx; border-radius: 12rpx; font-size: 24rpx; text-align: center; background: transparent; border: 1rpx solid rgba(255,255,255,0.1); color: #94a3b8; }
.end-btn { border-color: rgba(56,189,248,0.3); color: #38bdf8; }
.skip-btn { border-color: rgba(251,191,36,0.3); color: #fbbf24; }
.back-btn { font-size: 22rpx; color: #64748b; border: none; min-width: auto; flex: 0; }

.init-msg { text-align: center; padding-top: 40rpx; color: #94a3b8; font-size: 28rpx; }

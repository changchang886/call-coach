<!-- 最强对话 · 首页 -->
<view class="container">
  <view wx:if="{{!inChat}}" class="scene-view">
    <view class="header">
      <text class="title">📞 最强对话</text>
      <text class="subtitle">选场景，真人演练，沉浸式对话</text>
    </view>

    <view class="scene-grid">
      <block wx:for="{{scenes}}" wx:key="key">
        <view class="scene-card" bindtap="startChat" data-key="{{item.key}}">
          <text class="scene-emoji">{{item.emoji}}</text>
          <text class="scene-name">{{item.name}}</text>
          <text class="scene-goal">{{item.goal}}</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{inChat}}" class="chat-page">
    <view class="chat-scroll-wrap">
      <view class="chat-header">
        <text class="chat-scene">{{sceneName}}</text>
        <text class="chat-persona">✆ {{persona}} 已接通</text>
      </view>
      <scroll-view class="chat-area" scroll-y>
        <view wx:if="{{initializing}}" class="init-msg">{{loadingText}}</view>
        <block wx:else>
          <view wx:for="{{messages}}" wx:key="index" class="msg-item">
            <view class="{{item.role === 'assistant' ? 'msg-bot' : 'msg-user'}}">
              <text class="msg-label">{{item.role === 'assistant' ? '✆ ' + persona : '你'}}</text>
              <view class="msg-bubble {{item.role === 'assistant' ? 'msg-bubble-bot' : 'msg-bubble-user'}}">{{item.content}}</view>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>

    <view class="input-area">
      <view class="input-row">
        <input class="chat-input" value="{{inputText}}" placeholder="{{recording ? '正在聆听...' : '输入你要说的话...'}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" disabled="{{loading || recording}}" />
        <view class="mic-btn {{recording ? 'mic-active' : ''}}" bindtouchstart="startRecord" bindtouchend="stopRecord">🎤</view>
        <view class="send-btn {{(!inputText || loading) ? 'send-disabled' : ''}}" bindtap="sendMessage">发送</view>
      </view>
      <view class="chat-actions">
        <view class="action-btn end-btn" bindtap="endChat">📊 结束对话 · 评分</view>
        <view class="action-btn skip-btn" bindtap="skipChat">⚡ 跳过，直接出话术</view>
        <view class="action-btn back-btn" bindtap="goBack">← 返回</view>
      </view>
    </view>
  </view>
</view>
